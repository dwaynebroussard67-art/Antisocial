# Secrets — NEVER commit these.
# This repository is PUBLIC. apply-schema.mjs reads DATABASE_URL from
# .env.local, which means that file holds the production Postgres password.
# Committing it publishes the database credentials to the internet.
.env
.env.*
!.env.example

