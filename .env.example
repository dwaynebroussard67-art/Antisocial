# Postgres (Drizzle). Reuse the same instance as Misfit Ministries if
# possible — see apply-schema.mjs.
DATABASE_URL=

# Supabase — shared auth between Misfit Ministries and Antisocial.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — how Nura's Band B "get a human" holds actually reach a phone.
# Get a key at resend.com. Sending domain must be verified there before
# RESEND_FROM_EMAIL can be your own address; until then leave
# RESEND_FROM_EMAIL unset and Resend's shared onboarding@resend.dev sender
# is used as a fallback (works, but looks less trustworthy in an inbox).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nura <alerts@yourdomain.org>"

# Absolute base URL of this deployment, used to build the link inside a
# staff alert email (a relative path means nothing outside the app).
APP_BASE_URL=https://your-antisocial-deployment.vercel.app

# Optional: extra moderation lexicon, loaded at runtime, never committed to
# the repo. See src/lib/moderation/nura-classifier.ts for the JSON format.
NURA_LEXICON_JSON=
